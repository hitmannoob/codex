  "behaviors": [
    {"id":"BEH-001","area":"headers and authentication","source_url":"https://developers.openai.com/api/docs/guides/agents-api/quickstart#prerequisites","status":"partial","current":"Official-style routes require a bearer token and accept the beta header.","remaining":"Match header requirements, project permission failures, and documented error bodies across every operation."},
    {"id":"BEH-002","area":"agent omitted/null/update semantics","source_url":"https://developers.openai.com/api/docs/guides/agents-api/configuration#update-a-saved-agent","status":"partial","current":"Session overrides distinguish omitted from null for instructions/tools in the supported slice.","remaining":"Cover every saved-agent and session field, including reset-to-model-default behavior."},
    {"id":"BEH-003","area":"metadata constraints","source_url":"https://developers.openai.com/api/docs/guides/agents-api/configuration","status":"missing","current":"No complete contract implementation.","remaining":"Up to 16 string pairs; keys up to 64 and values up to 512 characters; define omission/null/empty replacement semantics."},
    {"id":"BEH-004","area":"cursor pagination","source_url":"https://developers.openai.com/api/docs/guides/agents-api/sessions/events#fetch-items-and-turns","status":"partial","current":"Items and turns support after/order/limit in the prototype.","remaining":"Apply stable created_at plus ID ordering, exclusive cursors, ownership validation, defaults, filters, and 1..100 limits to every list operation; environment files use opaque page tokens."},
    {"id":"BEH-005","area":"session input and idempotency","source_url":"https://developers.openai.com/api/docs/guides/agents-api/sessions#continue-or-steer-the-work","status":"partial","current":"One message, cancel, or tool result is supported per request.","remaining":"Implement batches, mixed-event validation/atomicity, images, conditional initial input, and persisted Idempotency-Key semantics without promising exactly-once execution."},
    {"id":"BEH-006","area":"stream ordering and recovery","source_url":"https://developers.openai.com/api/docs/guides/agents-api/sessions/events#how-to-recover-a-disconnected-stream","status":"partial","current":"Streams are live-only and durable items/turns can be read after disconnect.","remaining":"Complete event ordering and IDs, bound slow consumers, merge-by-item recovery races, and all terminal/error variants; never promise replay."},
    {"id":"BEH-007","area":"function required actions and results","source_url":"https://developers.openai.com/api/docs/guides/agents-api/tools/functions","status":"partial","current":"Pending function calls, text success/error results, identical retry receipts, and loss-to-unresolved behavior exist.","remaining":"Support content arrays, verified limits, multiple/batched results, generation fencing, cancellation races, and deferred tool search."},
    {"id":"BEH-008","area":"tool and capability configuration","source_url":"https://developers.openai.com/api/docs/guides/agents-api/overview#what-the-managed-harness-provides","status":"partial","current":"Function tools and server-configured MCP selection exist in the prototype.","remaining":"Implement tool_search, programmatic tool calling, API-described MCP transports/auth/origin, web search, skills/plugins, compaction, and complete isolation."},
    {"id":"BEH-009","area":"multi-agent orchestration","source_url":"https://developers.openai.com/api/docs/guides/agents-api/multi-agent","status":"missing","current":"Underlying Codex delegation exists but is not exposed through this API.","remaining":"Implement enabled/max_concurrent_subagents, default concurrency 6, parent/child ownership, cancellation, persistence, items/turns, events, and usage."},
    {"id":"BEH-010","area":"environment lifecycle","source_url":"https://developers.openai.com/api/docs/guides/agents-api/environments/lifecycle","status":"missing","current":"Official-style sessions accept environment none; the prototype has a non-contract read-only local mode.","remaining":"Implement self-hosted attachment first, then managed provisioning; five-minute input-time connection wait, no blind command/input replay, and separate session/compute ownership."},
    {"id":"BEH-011","area":"hosted environment configuration","source_url":"https://developers.openai.com/api/docs/guides/agents-api/environments/openai-hosted#configure-the-sandbox","status":"missing","current":"No public implementation.","remaining":"Implement packages, setup commands, files, env restrictions, skills/plugins, templates, capability directories, and network enabled/disabled/restricted with 1..100 exact hosts."},
    {"id":"BEH-012","area":"files and artifacts limits","source_url":"https://developers.openai.com/api/docs/guides/agents-api/environments/files#file-limits","status":"missing","current":"No public implementation.","remaining":"Enforce 50 creation files, 5 MiB inline each, 10 MiB inline total, 50 MiB Files API source, 200 MiB artifact, and 500 MiB published-output total; stream transfers and preserve artifact/session lifetime rules."},
    {"id":"BEH-013","area":"vaults and credentials","source_url":"https://developers.openai.com/api/docs/guides/agents-api/tools/vaults","status":"missing","current":"Session creation rejects vault_ids.","remaining":"Implement encrypted secret storage, metadata separation, MCP and environment-variable auth variants, OAuth rotation, networking restrictions, attachment, revocation, and redaction."},
    {"id":"BEH-014","area":"webhooks","source_url":"https://developers.openai.com/api/docs/guides/agents-api/sessions/webhooks","status":"missing","current":"No delivery implementation.","remaining":"Deliver the five inventoried event types with signed payloads, transactional outbox state, documented retry/deduplication behavior, and environment connection data."},
    {"id":"BEH-015","area":"usage accounting","source_url":"https://developers.openai.com/api/docs/guides/agents-api/observability#understand-token-usage","status":"missing","current":"Usage is unavailable.","remaining":"Expose best-effort nullable input/output/total counts plus cached and reasoning breakdowns; include subagents and retries without fabricating zero or final billing."},
    {"id":"BEH-016","area":"trace export","source_url":"https://developers.openai.com/api/docs/guides/agents-api/tracing#export-session-traces","status":"missing","current":"No public implementation and no Python SDK 3.17.0 resource method.","remaining":"Implement paginated OTLP JSON via raw HTTP and retain a fixture until SDK support exists."},
    {"id":"BEH-017","area":"worker and process recovery","source_url":"https://developers.openai.com/api/docs/guides/agents-api/overview","status":"partial","current":"Managed startup/shutdown and completed-session resume work; worker death terminates the API.","remaining":"Keep durable reads available during bounded reconnect, fence generations, reconcile outcomes/actions, and distinguish API, worker, environment, and client failure."},
